{
  "name": "puja-essentials",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --recursive --filter \"./apps/*\" build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --recursive typecheck",
    "test": "vitest run --coverage",
    "test:int": "pnpm --filter @pe/api test:int",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @pe/api db:generate",
    "db:migrate": "pnpm --filter @pe/api db:migrate",
    "db:seed": "pnpm --filter @pe/api db:seed",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "db:drift": "node scripts/check-migration-drift.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@pe/config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "otplib": "12.0.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
