# Copy to .env (git-ignored). Every key below is validated at boot by packages/shared/src/env.ts.
# Run `node scripts/generate-dev-env.mjs` to create a .env with fresh keys for local development.

# ---- runtime -------------------------------------------------------------------------------------
NODE_ENV=development                 # development | test | production
PORT=4000                            # API listen port
LOG_LEVEL=info                       # fatal | error | warn | info | debug | trace | silent

# ---- data stores (docker-compose defaults) --------------------------------------------------------
POSTGRES_USER=pe                     # compose only
POSTGRES_PASSWORD=pe                 # compose only
POSTGRES_DB=pe                       # compose only
DATABASE_URL=postgresql://pe:pe@localhost:5432/pe
VALKEY_URL=redis://localhost:6379

# ---- object storage (S3 API; MinIO locally) -------------------------------------------------------
MINIO_ROOT_USER=minioadmin           # compose only
MINIO_ROOT_PASSWORD=minioadmin       # compose only
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET_MEDIA=media
S3_BUCKET_IMPORTS=imports
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true             # true for MinIO/Garage, false for AWS S3

# ---- email (SMTP; Mailpit locally, SES SMTP in production) ----------------------------------------
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Puja Essentials <no-reply@example.test>

# ---- field-level encryption (32 random bytes, base64) ---------------------------------------------
ENCRYPTION_KEY_B64=                  # AES-256-GCM key for phone/address fields
BLIND_INDEX_KEY_B64=                 # HMAC-SHA256 key for phoneHmac lookups

# ---- JWT (RS256). JWT_KEYS_JSON = [{"kid","privatePem","publicPem"}]; JWT_PUBLIC_KEYS_JSON = [{"kid","publicPem"}]
JWT_ACTIVE_KID=k1
JWT_KEYS_JSON=                       # API only; generated by scripts/generate-dev-env.mjs
JWT_PUBLIC_KEYS_JSON=                # web only; public halves of JWT_KEYS_JSON
JWT_ISSUER=puja-essentials

# ---- service-to-service ---------------------------------------------------------------------------
API_INTERNAL_URL=http://localhost:4000   # web → API (private network in production)
WEB_ORIGIN=http://localhost:3000         # public origin of the storefront; used for CSRF and cookies
REVALIDATE_SECRET=                       # ≥16 chars; API → web on-demand ISR

# ---- payments (Razorpay test keys) ----------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# ---- adapters -------------------------------------------------------------------------------------
EMAIL_ADAPTER=smtp                   # smtp | fake (fake only when NODE_ENV=test)
STORAGE_ADAPTER=s3                   # s3
KEY_PROVIDER=env                     # env (KMS adapter arrives in Phase 2)
SHIPPING_ADAPTER=fake                # fake | shiprocket (adapter arrives in P14)
SEARCH_ADAPTER=noop                  # noop | postgres (adapter arrives in P04)
SHIPROCKET_EMAIL=                    # required when SHIPPING_ADAPTER=shiprocket
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_SECRET=

# ---- optional -------------------------------------------------------------------------------------
SENTRY_DSN=                          # empty disables error reporting
RATE_LIMIT_MULTIPLIER=               # only honoured when NODE_ENV=test
NEXT_PUBLIC_MEDIA_HOST=              # host allowed for next/image remote patterns (e.g. localhost:9000)
