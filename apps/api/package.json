{
  "name": "@pe/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:int": "vitest run -c vitest.int.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts",
    "seed:images": "tsx --env-file-if-exists=../../.env prisma/seed-images.ts",
    "seed:images:clear": "tsx --env-file-if-exists=../../.env prisma/seed-images-clear.ts",
    "seed:category-images": "tsx --env-file-if-exists=../../.env prisma/seed-category-images.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1138.0",
    "@aws-sdk/s3-request-presigner": "3.1138.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/sensible": "6.0.5",
    "@pe/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/html": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@types/react": "^19.3.0",
    "exceljs": "4.4.0",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "file-type": "22.1.1",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "nodemailer": "10.0.10",
    "otplib": "12.0.1",
    "papaparse": "5.7.0",
    "pg-boss": "12.34.0",
    "prisma": "6.19.3",
    "prom-client": "15.1.3",
    "qrcode": "1.5.4",
    "react": "^19.3.0",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@pe/config": "workspace:*",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/papaparse": "5.5.2",
    "@types/qrcode": "1.5.6",
    "@types/sanitize-html": "2.16.1",
    "@vitest/coverage-v8": "3.2.7",
    "testcontainers": "12.1.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
